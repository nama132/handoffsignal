# OpsRecovery V2 — environment variable NAMES and safe examples only.
# Never place a live secret in this file. Never commit a real .env.
# Contract: master prompt section 20.1.

# Runtime environment. One of: local | test | demo | pilot.
# Any other value fails startup.
APP_ENV=local

# Django secret key. Required in demo/pilot; must be high-entropy and owner-entered
# as a sealed platform variable. Known development defaults are REJECTED outside
# local/test. Local/test fall back to an explicit, clearly-marked dev value.
# DJANGO_SECRET_KEY=

# Explicit comma-separated host list for demo/pilot. Wildcards are rejected.
# DJANGO_ALLOWED_HOSTS=example.up.railway.app

# Explicit HTTPS origins for demo/pilot. Wildcards are rejected.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.up.railway.app

# One validated HTTPS origin used to build internal links in demo/pilot.
# APP_BASE_URL=https://example.up.railway.app

# V2 PostgreSQL only. SQLite is rejected in every environment.
DATABASE_URL=postgresql://opsrecovery:local-dev-only@127.0.0.1:5433/opsrecovery_v2

# V2 Redis only. Required wherever Celery runs.
REDIS_URL=redis://127.0.0.1:6380/0

# Master external side-effect switch. MUST be false through Phase 8.
# Demo/production startup rejects a true value.
EXTERNAL_ACTIONS_ENABLED=false

# Enables synthetic demo labelling and seed behaviour. Never an auth bypass.
DEMO_MODE=true

# Optional deterministic clock for the demo story (ISO 8601). local/demo only;
# rejected in pilot.
# DEMO_AS_OF=2026-09-01T09:00:00-04:00

# Evidence handling. MUST be metadata_only through Phase 8; arbitrary upload
# and blob storage are rejected.
EVIDENCE_MODE=metadata_only

# Allowlisted log level. Never enables request-body or secret logging.
LOG_LEVEL=INFO

# Optional error monitoring, demo/pilot only and only after explicit approval.
# Application works without it and applies redaction when enabled.
# SENTRY_DSN=

# NOTE: no SMS/email/messaging provider variable names appear here. They are not
# added until a pilot phase is approved and one provider has been selected
# (master prompt section 20.1).
